# Variables de referencia (ya estan embebidas en docker-compose.yml).
# Credenciales de BD (laboratorio, no usar en produccion):
MYSQL_ROOT_PASSWORD=rootpw
DB_NAME=shopdb
# Usuario de alto privilegio (app vulnerable)
APP_ROOT_USER=app_root
APP_ROOT_PASS=app_root_pw
# Usuario de minimo privilegio (app remediada)
APP_LEAST_USER=app_least
APP_LEAST_PASS=app_least_pw
