<%- include('partials/header') %>
<div class="panel-head">
  <span class="avatar"><%= user.username.charAt(0).toUpperCase() %></span>
  <div>
    <h1 style="margin:0;font-size:20px">Panel privado</h1>
    <p class="muted small" style="margin:2px 0 0">Sesi&oacute;n: <b><%= user.username %></b> &middot; rol <b><%= user.role %></b></p>
  </div>
</div>

<h2 style="font-size:16px;margin:0 0 10px">Datos sensibles &mdash; tabla <code>secrets</code></h2>
<table class="tbl">
  <thead><tr><th>Etiqueta</th><th>Valor</th><th>API token</th></tr></thead>
  <tbody>
    <% secrets.forEach(function(s){ %>
      <tr><td><%= s.label %></td><td><%= s.secret_value %></td><td><code><%= s.api_token %></code></td></tr>
    <% }); %>
  </tbody>
</table>
<%- include('partials/footer') %>
