<%- include('partials/header') %>
<div class="login-box">
  <h1>Ingresar</h1>
  <% if (error) { %><div class="alert"><%= error %></div><% } %>
  <% if (info)  { %><div class="info"><%= info %></div><% } %>
  <form method="post" action="/login">
    <label>Usuario <input type="text" name="username" autocomplete="off"></label>
    <label>Contrase&ntilde;a <input type="password" name="password" autocomplete="off"></label>
    <button type="submit">Entrar</button>
  </form>
  <p class="muted small">Usuarios de prueba: <code>admin</code>, <code>jlopez</code>, <code>mgarcia</code>.</p>
</div>
<%- include('partials/footer') %>
