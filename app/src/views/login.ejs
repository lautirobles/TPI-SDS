<%- include('partials/header') %>
<div class="auth">
  <div class="lock">&#128274;</div>
  <h1>Bienvenido de nuevo</h1>
  <p class="sub">Ingres&aacute; a tu cuenta de ShopLab</p>

  <% if (error) { %><div class="alert"><span>&#9888;&#65039;</span><div><%= error %></div></div><% } %>
  <% if (info)  { %><div class="info"><%= info %></div><% } %>

  <form method="post" action="/login">
    <div class="field">
      <label>Usuario</label>
      <input type="text" name="username" placeholder="tu usuario" autocomplete="off">
    </div>
    <div class="field">
      <label>Contrase&ntilde;a</label>
      <input type="password" name="password" placeholder="&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;" autocomplete="off">
    </div>
    <button type="submit" class="btn block">Ingresar</button>
  </form>

  <p class="hint">Usuarios de prueba: <code>admin</code> &middot; <code>jlopez</code> &middot; <code>mgarcia</code></p>
</div>
<%- include('partials/footer') %>
