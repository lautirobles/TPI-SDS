<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>ShopLab<%= isVuln ? ' · vulnerable' : ' · seguro' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
</head>
<body class="<%= isVuln ? 'env-vuln' : 'env-secure' %>">

  <header class="topbar">
    <div class="bar">
      <a class="brand" href="/"><span class="logo">&#128722;</span> Shop<b>Lab</b></a>
      <div class="navsearch">
        <form method="get" action="/">
          <input type="text" name="q" value="<%= (typeof q !== 'undefined' ? q : '') %>" placeholder="Buscar productos&hellip;" autocomplete="off">
          <button type="submit" aria-label="Buscar">&#128269;</button>
        </form>
      </div>
      <nav class="navactions">
        <% if (user) { %>
          <a href="/panel">Panel</a>
          <span class="who"><span class="avatar"><%= user.username.charAt(0).toUpperCase() %></span><%= user.username %></span>
          <form method="post" action="/logout" class="inline"><button class="linkbtn">Salir</button></form>
        <% } else { %>
          <a class="btn ghost" href="/login">Ingresar</a>
        <% } %>
      </nav>
    </div>
  </header>

  <main class="container">
